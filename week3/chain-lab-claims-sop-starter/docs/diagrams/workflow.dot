digraph G { rankdir=TB; graph [fontname=Arial,dpi=150,pad=0.2,nodesep=0.35,ranksep=0.5]; node [shape=box,style="rounded,filled",fillcolor="#DCE6F2",color="#1F3864",fontname=Arial,fontsize=18]; edge [color="#1F3864",fontname=Arial,fontsize=14];
 a [label="1 Run the starter\nobserve failures"]; b [label="2 Hunt: list\ninconsistencies"]; c [label="3 Write missing\npieces (M1 to M8)"]; d [label="4 Design the chain, write\nsystem message + prompt"]; e [label="5 Run before / after\nmock, then LIVE"]; f [label="6 Push to GitLab\nwalk the trainer through",fillcolor="#E2EFDA"];
 {rank=same;a;b;c} {rank=same;d;e;f} a->b->c; c->d; d->e->f; }