# Copy this file to .env and replace the placeholder with your programme key.
# .env is git-ignored. Never commit it and never paste the key into a prompt or a document.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model tiers used by the Python scripts (defaults shown).
CLAUDE_MODEL_OPUS=claude-opus-5-5
CLAUDE_MODEL_SONNET=claude-sonnet-5-5
CLAUDE_MODEL_HAIKU=claude-haiku-5-5
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5

# Safety and cost limits.
AGENT_MAX_STEPS=8
LLM_MAX_TOKENS=1024
CLAUDE_CLI_TIMEOUT_SECONDS=180
